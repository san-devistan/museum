type Span = { from: number; to: number }

export type Cue = { start: number; end: number; text: string }

// Start and end time, in seconds, of every character of the narration text.
export type CharacterTimes = {
  characters: string[]
  characterStartTimesSeconds: number[]
  characterEndTimesSeconds: number[]
}

type TimedCharacter = { text: string; start: number; end: number }

const maxCueLength = 110
const minCuePart = 28
const isSpace = (char: string | undefined) =>
  char !== undefined && /\s/.test(char)
const endsSentence = (char: string) => /[.!?…]/.test(char)

// A sentence ends at . ! ? or … before a space, or at the closing » right
// after one, so a quote keeps its marks: « Je l'étais déjà. »
function closesSentence(text: string, index: number) {
  const char = text[index]
  if (!isSpace(text[index + 1])) {
    return false
  }
  if (char === "»") {
    return endsSentence(text.slice(0, index).trimEnd().at(-1) ?? "")
  }
  return endsSentence(char) && !/^[^\S\n]+»/.test(text.slice(index + 1))
}

function sentenceSpans(text: string): Span[] {
  const spans: Span[] = []
  let from = -1
  for (let index = 0; index < text.length; index += 1) {
    const char = text[index]
    if (from < 0) {
      if (isSpace(char)) {
        continue
      }
      from = index
    }
    const next = text[index + 1]
    if (next === undefined || next === "\n" || closesSentence(text, index)) {
      spans.push({ from, to: index })
      from = -1
    }
  }
  return spans
}

function breakPoints(text: string, span: Span) {
  const points: { leftTo: number; rightFrom: number }[] = []
  for (let index = span.from + 1; index < span.to; index += 1) {
    const char = text[index]
    if (/[,;:]/.test(char) && isSpace(text[index + 1])) {
      points.push({ leftTo: index, rightFrom: index + 2 })
    } else if (char === "–" && isSpace(text[index - 1])) {
      points.push({ leftTo: index - 2, rightFrom: index })
    }
  }
  return points
}

function splitLong(text: string, span: Span): Span[] {
  const length = span.to - span.from + 1
  if (length <= maxCueLength) {
    return [span]
  }
  const middle = span.from + length / 2
  const candidates = breakPoints(text, span).filter(
    (point) =>
      point.leftTo - span.from >= minCuePart &&
      span.to - point.rightFrom >= minCuePart
  )
  if (candidates.length === 0) {
    return [span]
  }
  const best = candidates.reduce((closest, point) =>
    Math.abs(point.leftTo - middle) < Math.abs(closest.leftTo - middle)
      ? point
      : closest
  )
  return [
    ...splitLong(text, { from: span.from, to: best.leftTo }),
    ...splitLong(text, { from: best.rightFrom, to: span.to }),
  ]
}

function toMillis(seconds: number) {
  return Math.round(seconds * 1000) / 1000
}

export function buildCues(text: string, times: CharacterTimes): Cue[] {
  if (times.characters.join("") !== text) {
    throw new Error("Alignment does not match the narration text.")
  }
  return sentenceSpans(text)
    .flatMap((span) => splitLong(text, span))
    .map((span) => ({
      start: toMillis(times.characterStartTimesSeconds[span.from]),
      end: toMillis(times.characterEndTimesSeconds[span.to]),
      text: text.slice(span.from, span.to + 1),
    }))
}

const withoutSpaces = (value: string) => value.replace(/\s/g, "")

// Cues cover every character of their text but spaces, so cues built from an
// older text no longer read the same once spaces are dropped.
export function cuesMatchText(cues: readonly Cue[], text: string) {
  return (
    withoutSpaces(cues.map((cue) => cue.text).join("")) === withoutSpaces(text)
  )
}

// Forced alignment echoes the text back with its own whitespace (line breaks
// come back as \r\n), so walk both and keep one timing per text character.
export function timesForText(
  text: string,
  aligned: readonly TimedCharacter[]
): CharacterTimes {
  const times: CharacterTimes = {
    characters: [],
    characterStartTimesSeconds: [],
    characterEndTimesSeconds: [],
  }
  let cursor = 0
  let lastEnd = 0
  for (let index = 0; index < text.length; index += 1) {
    const char = text[index]
    while (
      aligned[cursor] !== undefined &&
      aligned[cursor].text !== char &&
      isSpace(aligned[cursor].text)
    ) {
      cursor += 1
    }
    const match = aligned[cursor]
    const start = match?.text === char ? match.start : lastEnd
    if (match?.text === char) {
      cursor += 1
      lastEnd = match.end
    } else if (!isSpace(char)) {
      throw new Error(`Alignment lost the text at character ${index}.`)
    }
    times.characters.push(char)
    times.characterStartTimesSeconds.push(start)
    times.characterEndTimesSeconds.push(lastEnd)
  }
  return times
}

export function cuesModule(exportName: string, cues: readonly Cue[]) {
  return `// Generated by scripts/narration/generate-narration.mts. Do not edit.
import type { NarrationCue } from "@/museum/narration/_lib/narration-cues"

export const ${exportName}: readonly NarrationCue[] = ${JSON.stringify(cues, null, 2)}
`
}
